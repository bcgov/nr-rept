# ===========================================
# REPT Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# Recommended to set sensitive values directly in the terminal environment for security
# Also i have seen these work better if set directly in terminal environment for spring boot apps

# Server Configuration
SERVER_PORT=3000

# Spring Profiles (oracle for Oracle DB connection)
SPRING_PROFILES_ACTIVE=oracle

# AWS Cognito Configuration
AWS_COGNITO_ISSUER_URI=https://cognito-idp.ca-central-1.amazonaws.com/YOUR_USER_POOL_ID

# nr-user-lookup-api — shared BC Gov IDIR directory (replaces the retired FAM
# identity-lookup). Calls authenticate with REPT's own Keycloak confidential
# service-account client via grant_type=client_credentials; the caller's
# Cognito token is NOT forwarded. Leave all of these blank to run without the
# directory (user search returns nothing) — set all of TOKEN_URL/CLIENT_ID/
# CLIENT_SECRET together or none, otherwise startup fails fast.
USER_LOOKUP_BASE_URL=
USER_LOOKUP_TOKEN_URL=
USER_LOOKUP_CLIENT_ID=
USER_LOOKUP_CLIENT_SECRET=
# Optional — the lookup scopes are DEFAULT client scopes on the service
# account, so this is normally left blank.
USER_LOOKUP_SCOPE=

# Database Configuration (Oracle - plain TCP, port 1521, no SSL required)
DATABASE_HOST=
SERVICE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Jasper Reports Configuration
J_URL_FETCH=
J_USERNAME=
J_PASSWORD=
J_CONNECT_TIMEOUT=10s
J_READ_TIMEOUT=60s

# Frontend CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOGGING_LEVEL=INFO
