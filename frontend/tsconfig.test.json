{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": [
      "@tanstack/react-query",
      "axios",
      "@vitest/browser/providers/playwright",
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/config/tests/**/*",
    "src/vite-env.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
