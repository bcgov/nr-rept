# ===========================================
# REPT Frontend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Application
VITE_APP_NAME=Real Estate Project Tracking
VITE_ZONE=dev

# Base Path (for deployments behind proxy, e.g., /pub/rept)
# Leave empty for local development
VITE_BASE_PATH=

# AWS Cognito Configuration
VITE_USER_POOLS_ID=
VITE_USER_POOLS_WEB_CLIENT_ID=

# Federated logout chain (Siteminder → Keycloak → Cognito → app). The frontend
# builds this itself so Cognito fires LAST (see context/auth/logoutChain.ts).
# All three are required for the chain; if any is blank, logout falls back to
# the plain Amplify hosted-UI sign-out, which returns to the app origin (the
# origin must be registered as a Cognito sign-out URL).
#   SITEMINDER_URL  — IDIR/BCeID logoff.cgi base (test: https://logontest7.gov.bc.ca/clp-cgi/logoff.cgi)
#   KEYCLOAK_URL    — Keycloak end-session endpoint (test: https://test.loginproxy.gov.bc.ca/auth/realms/standard/protocol/openid-connect/logout)
#   KEYCLOAK_CLIENT_ID — the app's FAM/Keycloak client id (get from FAM / Vault)
VITE_LOGOUT_SITEMINDER_URL=
VITE_LOGOUT_KEYCLOAK_URL=
VITE_LOGOUT_KEYCLOAK_CLIENT_ID=

# Backend API URL (for development)
VITE_BACKEND_URL=http://localhost:8080

# Node Environment
NODE_ENV=development

# Development Server (optional)
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000
VITE_HMR_HOST=localhost
VITE_HMR_PORT=3000
VITE_HMR_PROTOCOL=ws
